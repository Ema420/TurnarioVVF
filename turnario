<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Calendario turnario Vigili del Fuoco</title>
<style>
:root{--navy:#172b4d;--blue:#dcecff;--red:#ffe1dc;--green:#e3f3e7;--gray:#f1f3f5;--line:#d6dbe1;--ink:#202833}
*{box-sizing:border-box}body{margin:0;padding:28px;background:#f5f7fa;color:var(--ink);font:15px/1.45 Arial,sans-serif}.sheet{max-width:1100px;margin:auto;background:#fff;padding:28px;border:1px solid var(--line);box-shadow:0 8px 28px #172b4d12;border-radius:12px}h1{margin:0 0 5px;color:var(--navy);font-size:26px}.sub{margin:0 0 20px;color:#596575}.controls{display:flex;gap:12px;align-items:end;flex-wrap:wrap;margin:18px 0}.field{display:grid;gap:5px;font-weight:700;font-size:13px}select,input{font:inherit;padding:9px 10px;border:1px solid #b9c2cc;border-radius:6px;background:white}.button{padding:10px 16px;border:0;border-radius:6px;background:var(--navy);color:white;font-weight:700;cursor:pointer}.legend{display:flex;gap:16px;flex-wrap:wrap;margin:14px 0}.key{display:flex;align-items:center;gap:7px}.swatch{width:16px;height:16px;border:1px solid #0002;border-radius:3px}.calendar{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));border-top:1px solid var(--line);border-left:1px solid var(--line)}.weekday{padding:9px 5px;text-align:center;background:var(--navy);color:white;font-weight:700;border-right:1px solid #fff3}.day{min-height:105px;padding:8px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);position:relative}.day.empty{background:#fafbfc}.date{font-size:13px;font-weight:700;color:#536173}.shift{margin-top:10px;padding:7px 6px;border-radius:5px;font-size:12px;font-weight:700}.diurno{background:var(--blue);color:#124478}.notturno{background:var(--red);color:#8d2a1d}.riposo{background:var(--green);color:#28613a}.foot{margin-top:16px;color:#647080;font-size:12px}.tip{margin:14px 0 0;padding:10px 12px;background:#f5f7fa;border-left:3px solid #8aa1bd;font-size:13px}@media(max-width:700px){body{padding:8px}.sheet{padding:14px}.day{min-height:82px;padding:5px}.shift{font-size:10px;padding:5px 3px}.weekday{font-size:11px}.calendar{font-size:12px}}@media print{body{padding:0;background:white}.sheet{max-width:none;border:0;box-shadow:none;padding:8mm}.controls{display:none}.day{min-height:25mm}.tip{display:none}}
</style>
</head>
<body>
<main class="sheet">
<h1>Calendario turnario — Vigili del Fuoco</h1>
<p class="sub">Rotazione di esempio: lunedì diurno, martedì notturno, mercoledì e giovedì riposo; venerdì diurno e così via.</p>
<div class="controls">
<label class="field">Mese<select id="month"></select></label>
<label class="field">Anno<input id="year" type="number" min="2000" max="2100"></label>
<label class="field">Lunedì diurno di riferimento<input id="anchor" type="date" value="2026-01-05"></label>
<button class="button" id="print">Stampa / Salva come PDF</button>
</div>
<div class="legend"><span class="key"><i class="swatch" style="background:var(--blue)"></i>Diurno 08:00–20:00</span><span class="key"><i class="swatch" style="background:var(--red)"></i>Notturno 20:00–08:00 del giorno successivo</span><span class="key"><i class="swatch" style="background:var(--green)"></i>Riposo</span></div>
<div id="calendar" class="calendar" aria-live="polite"></div>
<p class="tip">Per iniziare da una data diversa, seleziona nel campo “Lunedì diurno di riferimento” una data in cui la squadra è effettivamente di turno diurno. La sequenza si ripete ogni 4 giorni: diurno, notturno, riposo, riposo.</p>
<p class="foot">Calendario indicativo: verificare sempre la turnazione ufficiale della propria sede e gli eventuali servizi o variazioni.</p>
</main>
<script>
const months=['Gennaio','Febbraio','Marzo','Aprile','Maggio','Giugno','Luglio','Agosto','Settembre','Ottobre','Novembre','Dicembre'];
const weekdays=['Lunedì','Martedì','Mercoledì','Giovedì','Venerdì','Sabato','Domenica'];
const monthEl=document.getElementById('month'), yearEl=document.getElementById('year'), anchorEl=document.getElementById('anchor'), calendar=document.getElementById('calendar');
months.forEach((m,i)=>{const o=document.createElement('option');o.value=i;o.textContent=m;monthEl.appendChild(o)});
const today=new Date();monthEl.value=today.getMonth();yearEl.value=today.getFullYear();
function dateUTC(s){const [y,m,d]=s.split('-').map(Number);return Date.UTC(y,m-1,d)}
function render(){const y=Number(yearEl.value),m=Number(monthEl.value);if(!y||y<2000||y>2100)return;calendar.replaceChildren();weekdays.forEach(w=>{const el=document.createElement('div');el.className='weekday';el.textContent=w;calendar.appendChild(el)});const first=new Date(y,m,1),offset=(first.getDay()+6)%7,days=new Date(y,m+1,0).getDate();for(let i=0;i<offset;i++){const e=document.createElement('div');e.className='day empty';calendar.appendChild(e)}const anchor=dateUTC(anchorEl.value);for(let d=1;d<=days;d++){const cell=document.createElement('div');cell.className='day';const date=new Date(y,m,d);const delta=Math.round((Date.UTC(y,m,d)-anchor)/86400000);const cycle=((delta%4)+4)%4;const number=document.createElement('div');number.className='date';number.textContent=d;cell.appendChild(number);const label=document.createElement('div');if(cycle===0){label.className='shift diurno';label.textContent='DIURNO · 08:00–20:00'}else if(cycle===1){label.className='shift notturno';label.textContent='NOTTURNO · 20:00–08:00'}else{label.className='shift riposo';label.textContent='RIPOSO'}cell.appendChild(label);if(cycle===1){const note=document.createElement('div');note.style.cssText='font-size:10px;margin-top:4px;color:#6b7280';note.textContent='termina domani alle 08:00';cell.appendChild(note)}calendar.appendChild(cell)}}
monthEl.addEventListener('change',render);yearEl.addEventListener('input',render);anchorEl.addEventListener('change',render);document.getElementById('print').addEventListener('click',()=>window.print());render();
</script>
</body>
</html>
